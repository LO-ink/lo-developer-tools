{
  "name": "@lo-ink/developer-tools",
  "version": "0.3.6",
  "description": "Project validation and development tools for LO applications",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/manifest.d.mts",
      "import": "./src/manifest.mjs",
      "default": "./src/manifest.mjs"
    }
  },
  "bin": {
    "lo": "bin/lo.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "security"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/lo.mjs && node --check src/manifest.mjs && node --check actions/publish-npm/publish.mjs",
    "lint": "eslint . --max-warnings 0",
    "architecture": "depcruise --config .dependency-cruiser.cjs src bin actions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security": "npm audit --audit-level=high",
    "test:coverage": "c8 node --test test/*.test.mjs",
    "build": "npm pack --dry-run",
    "policy": "node --test scripts/check-policy.test.mjs && node scripts/check-policy.mjs",
    "secrets": "node scripts/check-secrets.mjs",
    "ci": "make ci"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LO-ink/lo-developer-tools.git"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  }
}
